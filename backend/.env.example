# Application
APP_NAME=AML_Platform-backend
ENVIRONMENT=local
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///./dev.db

# Supabase (https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DATABASE_URL=postgresql+psycopg://postgres:password@db.your-project.supabase.co:6543/postgres

# Google Service Account (https://cloud.google.com/iam/docs/service-accounts)
# Paste the full JSON key content, or set a file path to the JSON key.
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
# GOOGLE_SERVICE_ACCOUNT_KEY=./vizlabel-498314-d6b987d88174.json

GOOGLE_DRIVE_PARENT_FOLDER_ID=your_folder_id_here
# Service accounts lack personal Drive quota.
# Create a Shared Drive and add the service account as a member (Content Manager or higher).
# GOOGLE_DRIVE_SHARED_DRIVE_ID=your-shared-drive-id

# Cloudflare (https://cloudflare.com)
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
CLOUDFLARE_D1_DATABASE_ID=your-d1-database-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-key
CLOUDFLARE_R2_BUCKET_NAME=your-bucket-name
CLOUDFLARE_R2_PUBLIC_URL=https://pub-XXXX.r2.dev
